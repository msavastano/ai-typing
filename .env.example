# No Anthropic API key is needed here.
# Each user supplies their own Anthropic API key in the app (Dashboard → Anthropic API key).
# The key is held only in the browser session — it is never read from the server environment.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
